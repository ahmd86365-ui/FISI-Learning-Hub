# Password required to access the FISI Learning Hub. Set a real value in a
# local .env file (never commit that file) or as a server/platform env var.
APP_PASSWORD=Admin&0991

# Optional: override the auto-derived session-signing secret.
# SESSION_SECRET=CHANGE_ME_TOO

# Optional: port the server listens on (default 3000).
# PORT=3000

# Optional: set to "true" once the app is served over HTTPS, to mark the
# session cookie Secure.
# COOKIE_SECURE=false
